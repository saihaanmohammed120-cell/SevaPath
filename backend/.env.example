# Example production environment configuration for the Backend
# Do NOT commit the actual .env file.

# When deploying the backend (e.g., to Render/Railway) separately from the frontend,
# you MUST define the absolute URL of the deployed React frontend so CORS allows the requests.
CORS_ORIGINS=https://YOUR-FRONTEND-DOMAIN

# AI Provider Keys
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
